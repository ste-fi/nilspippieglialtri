      <div type="chapter" n="1" xml:id="cap01">
        <head>Pojken</head>
        <!-- titolo del capitolo e testo da collazionare con l'edizione digitale -->
        <p>
          Det var en gång <rs type="person" ref="#nils">en pojke</rs>.
          Han var kanske fjorton år gammal, lång och slokig och blåvit i håret.
          Han dög inte mycket till.
        </p>
